{
  "Database": {
    "Provider": "PostgreSql"
  },
  "Auth": {
    "SessionDurationMinutes": 120,
    "RememberMeDurationMinutes": 43200,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 10,
    "EmailVerificationMinutes": 10,
    "RateLimitPermitLimit": 10,
    "RateLimitWindowMinutes": 1
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-neon-host;Port=5432;Database=your-database;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true"
  }
}
