{
  "Database": {
    "Provider": "Sqlite"
  },
  "Auth": {
    "SessionDurationMinutes": 120,
    "SessionCacheSeconds": 15,
    "RememberMeDurationMinutes": 43200,
    "RefreshTokenDurationMinutes": 43200,
    "PasswordResetMinutes": 30,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 10,
    "EmailVerificationMinutes": 1440,
    "EmailVerificationResendCooldownMinutes": 5,
    "RateLimitPermitLimit": 10,
    "RateLimitWindowMinutes": 1
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=techyouth-bpm.db"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Proxy": {
    "TrustForwardedProto": false
  },
  "Email": {
    "Provider": "Demo",
    "FromAddress": "no-reply@techyouth.local",
    "FromName": "TechYouth BPM",
    "AllowedRecipients": "",
    "AllowedUsernames": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true
    },
    "Sandbox": {
      "FromAddress": "sandbox@techyouth.local",
      "FromName": "TechYouth BPM Sandbox",
      "Smtp": {
        "Host": "",
        "Port": 2525,
        "Username": "",
        "Password": "",
        "EnableSsl": true
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
